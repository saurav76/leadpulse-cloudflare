{
  "name": "leadpulse-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare-native LeadPulse SaaS pilot using Workers, D1 and Browser Run",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply leadpulse-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply leadpulse-db --remote",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.0"
  },
  "devDependencies": {
    "wrangler": "^4.102.0"
  },
  "engines": {"node": ">=20"}
}
